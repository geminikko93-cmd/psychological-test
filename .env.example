# JP 숏폼 작업실 — AI 중개서버 연결 설정
# 이 파일을 복사해 같은 폴더에 ".env" 로 저장하고 YOUR_API_KEY 자리에 받은 키를 넣으세요.
# .env 는 git에 올라가지 않으며, 프로젝트·내보내기 파일에도 들어가지 않습니다.
# 파일을 고치면 프로그램을 다시 시작하지 않아도 다음 AI 요청부터 반영됩니다.

# API 키 (Claude Code 설정의 ANTHROPIC_AUTH_TOKEN 과 같은 값, Authorization: Bearer 로 전송)
ANTHROPIC_AUTH_TOKEN=YOUR_API_KEY

# 중개서버 주소 (요청은 이 주소 + /v1/messages 로 보냅니다)
ANTHROPIC_BASE_URL=https://codex.hungnguyen.codes

# 사용할 모델. 중개서버 안내에 있는 모델 중에서 고르세요.
#   claude-opus-4-8  (대본·기획 품질 우선, 기본)
#   claude-sonnet-5  (빠르고 저렴)
#   claude-fable-5   (가장 강력, 비쌈·느림)
#   claude-haiku-4-5-20251001 (가장 가벼움)
ANTHROPIC_MODEL=claude-opus-4-8
